<?xml version="1.0" encoding="utf-8"?>
<launch>
  <arg name="map_file" />
  <arg name="scenarios_file" default="" />
  <arg name="output_result" default="" />
  <arg name="self_test_output" default="" />
  <arg name="input_param" default="$(find path_finder)/config/paper_table1_final.json" />
  <arg name="methods" default="connect+independent,fconnect+independent,connect+reserve,fconnect+reserve,fconnect+separated" />
  <arg name="trials" default="5" />
  <arg name="seed" default="1" />
  <arg name="robot_radius" default="0.25" />
  <arg name="margin" default="0.1" />
  <arg name="time_limit_call" default="5.0" />
  <arg name="time_limit_total" default="60.0" />
  <arg name="path_trials" default="1" />
  <arg name="separated_max_n" default="1000" />

  <arg name="global_env_pcd2_topic" value="/random_forest/all_map" />
  <!-- high enough that the time limit decides, not the iteration count -->
  <arg name="brrt_max_iteration" default="100000000" />
  <arg name="max_tree_node_nums" default="200000" />

  <node pkg="pcl_ros" type="pcd_to_pointcloud" name="pcd_to_pointcloud" args="$(arg map_file) 1">
    <param name="frame_id" value="map" />
    <remap from="/cloud_pcd" to="$(arg global_env_pcd2_topic)" />
  </node>

  <node pkg="path_finder" type="multi_robot_node" name="multi_robot_node" output="screen" required="true">
    <remap from="/global_cloud" to="$(arg global_env_pcd2_topic)" />

    <param name="scenarios_file" value="$(arg scenarios_file)" type="string" />
    <param name="output_result" value="$(arg output_result)" type="string" />
    <param name="self_test_output" value="$(arg self_test_output)" type="string" />
    <param name="input_param" value="$(arg input_param)" type="string" />
    <param name="methods" value="$(arg methods)" type="string" />
    <param name="trials" value="$(arg trials)" type="int" />
    <param name="seed" value="$(arg seed)" type="int" />
    <param name="robot_radius" value="$(arg robot_radius)" type="double" />
    <param name="margin" value="$(arg margin)" type="double" />
    <param name="time_limit_call" value="$(arg time_limit_call)" type="double" />
    <param name="time_limit_total" value="$(arg time_limit_total)" type="double" />
    <param name="path_trials" value="$(arg path_trials)" type="int" />
    <param name="separated_max_n" value="$(arg separated_max_n)" type="int" />

    <!-- same map and planner settings as test_planners.launch -->
    <param name="occ_map/origin_x" value="-100.0" type="double" />
    <param name="occ_map/origin_y" value="-100.0" type="double" />
    <param name="occ_map/origin_z" value="-1.0" type="double" />
    <param name="occ_map/map_size_x" value="200.0" type="double" />
    <param name="occ_map/map_size_y" value="200.0" type="double" />
    <param name="occ_map/map_size_z" value="1.5" type="double" />
    <param name="occ_map/resolution" value="0.5" type="double" />

    <param name="BRRT/steer_length" value="1" type="double" />
    <param name="BRRT/search_time" value="1" type="double" />
    <param name="BRRT/max_tree_node_nums" value="$(arg max_tree_node_nums)" type="int" />
    <param name="BRRT/step" value="0.5" type="double" />
    <param name="BRRT/max_iteration" value="$(arg brrt_max_iteration)" type="int" />

    <param name="BRRT_Optimize/p1" value="1.0" type="double" />
    <param name="BRRT_Optimize/u_p" value="0.5" type="double" />
    <param name="BRRT_Optimize/step" value="0.5" type="double" />
    <param name="BRRT_Optimize/alpha" value="7.0" type="double" />
    <param name="BRRT_Optimize/beta" value="2.0" type="double" />
    <param name="BRRT_Optimize/gamma" value="2.0" type="double" />
    <param name="BRRT_Optimize/max_iteration" value="$(arg brrt_max_iteration)" type="int" />
    <param name="BRRT_Optimize/n_rays" value="9" type="int" />
    <param name="BRRT_Optimize/weight_grade" value="1" type="int" />
    <param name="BRRT_Optimize/enable2d" value="true" type="bool" />
  </node>
</launch>
